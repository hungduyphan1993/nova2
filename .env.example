# ============================================================================
# Whitelabel Brand, Portal Discovery & Playback Defaults
# Every value is OPTIONAL — omit or leave any secret unset to fall back to
# the built-in NovaStream defaults.
# ============================================================================

# --- Brand Identity & Android Packaging ---
WHITELABEL_APP_NAME=NovaStream Player
WHITELABEL_LAUNCHER_LABEL=NovaStream
WHITELABEL_APPLICATION_ID=com.aistudio.novastream.qrxvkp
WHITELABEL_TAGLINE=Xtream Codes • M3U/M3U8 • XMLTV EPG
WHITELABEL_LOGO_URL=

# --- Dynamic Brand Color Palette (6-digit #RRGGBB or 8-digit #AARRGGBB) ---
WHITELABEL_PRIMARY_COLOR=#00E5FF
WHITELABEL_SECONDARY_COLOR=#8C52FF
WHITELABEL_ACCENT_COLOR=#FFB800
WHITELABEL_BG_COLOR=#06080D

# --- Optional Operator Customer Support ---
WHITELABEL_SUPPORT_TEXT=
WHITELABEL_SUPPORT_URL=

# --- Optional Xtream Portal Discovery API Server ---
# When set, users can leave Server URL blank in the app and the client will
# fetch the active Xtream portal URL from this endpoint.
WHITELABEL_API_SERVER=

# --- Operator Playback & Network Defaults ---
WHITELABEL_DEFAULT_USER_AGENT=NovaStream/1.0 (Android)
# Allowed engines: EXOPLAYER, LIBVLC, LIBMPV, EXTERNAL_MPV, EXTERNAL_VLC,
# EXTERNAL_MX, EXTERNAL_JUST, EXTERNAL_KODI, EXTERNAL_CHOOSER
WHITELABEL_DEFAULT_ENGINE=EXOPLAYER

# --- Emulator Debug APK ABI (for .build-outputs/app-debug.apk size limits) ---
# Allowed: x86_64 (default, ~70 MB), arm64-v8a (~67 MB), x86, armeabi-v7a, universal (~180 MB)
# EMULATOR_DEBUG_ABI=x86_64

# --- Optional Gemini API Key ---
# GEMINI_API_KEY=MY_GEMINI_API_KEY
